{
	"name": "jmuzina.io",
	"author": {
		"name": "Julie Mužina",
		"email": "jmuzina@jmuzina.io"
	},
	"repository": "https://github.com/jmuzina/jmuzina.io",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": " svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"check:fix": "svelte-kit sync && pnpm run check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fix:all": "pnpm check:fix && pnpm lint:fix",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "pnpm run format && eslint --fix .",
		"format": "prettier --check --write .",
		"test:client:watch": "vitest --config vitest.config.client.ts",
		"test:server:watch": "vitest --config vitest.config.server.ts",
		"test:watch": "pnpm run test:client:watch & pnpm run test:server:watch",
		"test:client": "vitest run --config vitest.config.client.ts",
		"test:server": "vitest run --config vitest.config.server.ts",
		"test": "pnpm run test:client && pnpm run test:server"
	},
	"devDependencies": {
		"@boxicons/svelte": "^1.0.1",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@lucide/svelte": "^1.48.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^4.0.18",
		"@vitest/coverage-v8": "^4.0.18",
		"axe-core": "^4.13.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"lucide": "^1.48.0",
		"playwright": "^1.58.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^3.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.10",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
