{
	"name": "jmuzina.io",
	"author": {
		"name": "Julie Mužina",
		"email": "jmuzina@jmuzina.io"
	},
	"repository": "https://github.com/jmuzina/jmuzina.io",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && markdownlint-cli2 && vale *.md src e2e && shellcheck scripts/*.sh",
		"lint:build": "vale --config=.vale.build.ini --glob=\"*.html\" build",
		"lint:fix": "prettier --write . && eslint --fix . && markdownlint-cli2 --fix",
		"fix": "pnpm run lint:fix && pnpm run check && pnpm run lint",
		"test": "pnpm run test:unit && pnpm run test:component",
		"test:unit": "vitest run --project server",
		"test:unit:watch": "vitest --project server",
		"test:component": "vitest run --project client",
		"test:component:watch": "vitest --project client",
		"test:e2e": "playwright test",
		"test:e2e:visual": "sh scripts/e2e-visual.sh",
		"test:e2e:visual:update": "sh scripts/e2e-visual.sh --update-snapshots"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.1",
		"@boxicons/svelte": "^1.0.1",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.48.0",
		"@playwright/test": "^1.65.1",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^4.0.18",
		"axe-core": "^4.13.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"hast-util-from-html": "^2.1.0",
		"hast-util-to-mdast": "^10.1.4",
		"markdownlint-cli2": "^0.24.2",
		"mdast-util-to-markdown": "^2.2.4",
		"mdsvex": "^0.12.8",
		"playwright": "^1.58.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.0.12",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^3.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.10",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
